<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>

    <!-- AOT compile the host app — plugin DLLs loaded at runtime stay interpreted -->
    <RunAOTCompilation>true</RunAOTCompilation>
    <TrimMode>partial</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <StaticWebAssetFingerprintPattern Include="JS" Pattern="*.js" Expression="#[.{fingerprint}]!" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BrowserPluginApi\BrowserPluginApi.csproj" />
  </ItemGroup>
</Project>
